{
  "name": "tokenomics-agents",
  "version": "1.0.0",
  "description": "Tokenomics.net AI Content Generation Agents",
  "type": "module",
  "main": "src/agent.ts",
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "nodemon --watch src --ext ts,js,mjs,json --signal SIGTERM -x \"npx adk api_server src --host 0.0.0.0 --port ${PORT:-8000}\"",
    "dev:web": "nodemon --watch src --ext ts,js,mjs,json --signal SIGTERM -x \"npx adk web src --host 0.0.0.0 --port ${PORT:-8000}\"",
    "dev:cli": "npx adk run src/agent.ts",
    "start": "npm run start:prod",
    "start:prod": "npx adk api_server src --host 0.0.0.0 --port ${PORT:-8000}",
    "ingest": "uv run --with chromadb python src/scripts/ingest.py",
    "ingest:dry-run": "uv run --with chromadb python src/scripts/ingest.py --dry-run"
  },
  "dependencies": {
    "@google/adk": "^0.5.0",
    "@google/genai": "^1.0.0",
    "@aws-sdk/client-s3": "^3.1008.0",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "puppeteer": "^23.11.1",
    "sharp": "^0.34.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@google/adk-devtools": "^0.5.0",
    "@types/node": "^22.0.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.7.0"
  }
}